# Binaries — go build output and goreleaser artifacts.
# IMPORTANT: anchor with / so the patterns only match at the repo root.
# Without the anchor, `bclgen` also matches every subdirectory of the
# same name (cmd/bclgen/, internal/bclgen/) and silently excludes the
# source tree from git.
/bclgen
/bclgen.exe
/dist/

# Test binary, build artifacts, coverage profile
*.test
*.out
coverage.out
coverage.html

# Go workspace files (we don't use them; ignore if someone tries)
go.work
go.work.sum

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Env
.env
.envrc

# OS
.DS_Store

# Local scratch from manual testing
/mockrun/
/bigtest/
/progtest/
